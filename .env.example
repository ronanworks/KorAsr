# Moonshot API authentication key — get yours at platform.moonshot.cn
MOONSHOT_API_KEY=sk-your-key-here
# moonshot-v1 models have been retired; the 2026-09-27 CN account lists kimi-k2.6.
# This name is used for realtime, polish and summaries.
MOONSHOT_MODEL=kimi-k2.6
# Match this URL to the console that issued your API Key. Never send the Key
# to a different region merely to probe whether it works.
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# Moonshot requests per minute from this server, shared by live translation (one request
# per sentence and target language), per-minute polish, outline and summaries. The account
# limit is 100/min for the whole organisation (429 "request reached organization max RPM:
# 100"); keep headroom for other users of the same key. 0 = no limit.
MOONSHOT_MAX_RPM=60

# Accounts are stored in SQLite. After configuring DATABASE_URL, create the
# first administrator locally with:
# python -m backend.admin create-user --username admin --admin
# The old shared KORASR_ACCESS_TOKEN setting is no longer used for login.

# SQLite database path
# Linux/Mac relative: sqlite:///./data/korasr.db
# Windows absolute:   sqlite:///C:/leolee/data/korasr.db
DATABASE_URL=sqlite:///./data/korasr.db

# Raw PCM dump dir (per-session <sid>.pcm; source of truth for polish)
# Defaults to data/raw if unset. Windows e.g. C:\leolee\data\raw
# RAW_AUDIO_DIR=data/raw

# HuggingFace cache root (faster-whisper downloads models under $HF_HOME/hub/)
# Windows e.g. C:\leolee\models
# HF_HOME=

# Extra hostnames / IPs to embed as cert SAN (comma-separated).
# gethostname-based discovery misses Tailscale/VPN virtual NICs — add them here.
# e.g. EXTRA_CERT_SANS=100.95.4.120,tailnet-name.ts.net
# EXTRA_CERT_SANS=

# ASR backend: faster_whisper (CTranslate2; CPU/CUDA, Windows+Linux) or mlx (Apple Silicon only)
ASR_BACKEND=faster_whisper

# ASR model. Three ways to set this:
#   1) Built-in short name:    large-v3 (best accuracy), large-v3-turbo (~2x faster), medium, small
#   2) HF repo with CT2 weights:  Systran/faster-whisper-large-v3
#   3) Local CT2 dir (for finetuned models you converted yourself):
#         models/ghost613-ko    <- run: python scripts/convert_to_ct2.py ghost613/whisper-large-v3-turbo-korean
#      That HF finetune reports CER 2.06% on zeroth-korean; A/B with scripts/bench_asr.py first.
ASR_MODEL=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16

# Beam size: higher = more accurate, slightly slower. 5 is recommended for 4090.
ASR_BEAM_SIZE=5

# Optional ASR hint. Leave empty unless you have tested a short list of actual
# course-specific terms. Generic lecture sentences can be echoed as subtitles.
ASR_INITIAL_PROMPT=
# Keep empty: on the 2026-09-28 class a generic Chinese prompt made Whisper replace
# real speech with "请不吝点赞 订阅 转发…" style video-credit hallucinations.
ASR_INITIAL_PROMPT_ZH=

# Max seconds of audio to buffer before forcing transcription
ASR_MAX_BUFFER_S=6.0
# Minimum seconds of audio required to attempt transcription
ASR_MIN_BUFFER_S=0.5

# Whisper confidence thresholds (lower = stricter filtering of bad outputs)
ASR_NO_SPEECH_THRESHOLD=0.6
ASR_COMPRESSION_RATIO_THRESHOLD=2.2
ASR_LOG_PROB_THRESHOLD=-1.0
ASR_REPETITION_PENALTY=1.1

# Set true only if A/B tests show better long-form Korean recognition.
# False reduces repetition/hallucination from Whisper's own prior text.
POLISH_CONDITION_ON_PREVIOUS_TEXT=false
# Per-minute polish re-recognises each speaker run (<=28 s, VAD-filtered) and keeps
# the result only when it agrees with the live text. ~3 s GPU per minute of class.
POLISH_REASR=true

# Mandarin clips: sensevoice (CPU, fewer errors than Whisper in the 09-29 comparison;
# download: python scripts/download_asr_models.py) or whisper. Korean always uses Whisper.
ASR_ZH_ENGINE=sensevoice
# SENSEVOICE_THREADS=4

# Speaker diarization (CAM++ voiceprint, CPU). Download the model once with
#   python scripts/download_speaker_model.py
# Missing model -> speakers are simply not labelled; transcription still works.
SPEAKER_ENABLED=true
# SPEAKER_MODEL_PATH=models/speaker/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx

# Voice Activity Detection sensitivity (0.0-1.0, higher = stricter)
VAD_THRESHOLD=0.5
# Milliseconds of silence before considering a sentence complete (600 = faster cuts)
VAD_MIN_SILENCE_MS=600
# Minimum milliseconds of speech to consider valid (filters noise)
VAD_MIN_SPEECH_MS=250

# 小声增强 (quiet-speaker boost): gain on the copy of the audio that Silero VAD sees, so a
# distant, quiet speaker still gets cut into sentences. The recording and the audio sent to
# Whisper are never changed. The classroom switch turns it on per class; this is the state
# a connection starts in (the browser sends its own choice right after connecting).
# Off by default: it recovers many quiet turns on some classes but adds some wrong sentences.
VAD_INPUT_GAIN_DEFAULT=false
# Strength when switched on (dB, upper limit of the gain)
VAD_INPUT_GAIN_MAX_DB=12.0

# Comma-separated Whisper hallucination patterns to suppress (substrings of short outputs).
# Do not list "구독" or "좋아요" alone: they removed real speech ("구독료"); list the outro phrases.
HALLUCINATION_BLACKLIST=자막,시청해주셔서,MBC,SBS,KBS,구독과 좋아요,구독 좋아요,구독 부탁,좋아요 부탁,좋아요와 구독,기상캐스터,다음 영상에서 만나요,시청자 여러분,Korean university lecture,이것은 한국 대학교,자막 제공,번역 제공,cc 자막,한국어 자막,감사합니다,안녕하세요,시청해 주셔서
